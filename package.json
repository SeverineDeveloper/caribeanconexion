{
  "name": "conexion-caribe",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @cc/web --filter @cc/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d db",
    "db:generate": "pnpm --filter @cc/db generate",
    "db:migrate": "pnpm --filter @cc/db migrate:dev",
    "db:deploy": "pnpm --filter @cc/db migrate:deploy",
    "admin:create": "pnpm --filter @cc/web admin:create"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "6.0.3"
  }
}
