# Copiar a .env y completar. Nunca commitear .env.

# Base de datos (docker compose expone Postgres en el puerto 5433)
DATABASE_URL=postgresql://cc:cc@localhost:5433/conexion_caribe

# Better Auth: secreto de 32+ caracteres (openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Número de WhatsApp en formato internacional, sin "+" ni espacios
NEXT_PUBLIC_WHATSAPP_NUMBER=18296313468

# Primer administrador (pnpm admin:create)
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Sentry (opcional: vacío = desactivado)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
